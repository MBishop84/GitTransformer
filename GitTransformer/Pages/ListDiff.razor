@page "/list_diff"
@page "/GitTransformer/list_diff"
@inject AppData AppData
@using GitTransformer.Pages.Components
@inject DialogService DialogService

<RadzenStack Orientation="Orientation.Vertical"
             AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.Center"
             Gap="5px"
             Style="width: 100%">
    <RadzenStack Orientation="@Orientation"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.Center"
                 Gap="5px"
                 Style="width: 100%">
        <RadzenFieldset Text="@($"List A [{stringA?.Split('\n', StringSplitOptions.RemoveEmptyEntries).Count() ?? 0}]")"
                        Style="width: 100%">
            <RadzenTextArea @bind-Value="@stringA"
                            Rows="@(AppData.WindowHeight / 75)"
                            Style="width: 100%"
                            Change="RenderList" />
        </RadzenFieldset>
        <RadzenFieldset Text="@($"List A [{stringB?.Split('\n', StringSplitOptions.RemoveEmptyEntries).Count() ?? 0}]")"
                        Style="width: 100%">
            <RadzenTextArea @bind-Value="@stringB"
                            Rows="@(AppData.WindowHeight / 75)"
                            Style="width: 100%"
                            Change="RenderList" />
        </RadzenFieldset>
    </RadzenStack>
    <RadzenFieldset Text="Settings" Style="width: 100%" AllowCollapse="true">
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.Center"
                     Gap="5px"
                     Style="width: 100%"
                     Wrap="FlexWrap.Wrap">
            <RadzenCheckBoxList @bind-Value=@options
                                TValue="int"
                                Orientation="Orientation.Horizontal"
                                AlignItems="AlignItems.Center"
                                JustifyContent="JustifyContent.Center"
                                Wrap="FlexWrap.Wrap"
                                Change="RenderList">
                <Items>
                    <RadzenCheckBoxListItem Text="Case Sensitive" Value="1" />
                    <RadzenCheckBoxListItem Text="Ignore Leading/Trailing Space" Value="2" />
                    <RadzenCheckBoxListItem Text="Sort" Value="3" />
                </Items>
            </RadzenCheckBoxList>
            <RadzenTextBox @bind-Value=@splitString
                           Style="width: 100%; max-width: 400px;"
                           Placeholder="Split chars..."
                           Change="RenderList" />
        </RadzenStack>
    </RadzenFieldset>
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.Center"
                 Gap="5px"
                 Style="width: 100%"
                 Wrap="@Wrap">
        <ListDiffResult Title="A Only"
                        Count="@aOnlyList.Count"
                        @bind-Text="@aOnly"
                        Rows="@(AppData.WindowHeight / 75)" />
        <ListDiffResult Title="B Only"
                        Count="@bOnlyList.Count"
                        @bind-Text="@bOnly"
                        Rows="@(AppData.WindowHeight / 75)" />
        <ListDiffResult Title="A &amp; B (Both)"
                        Count="@bothList.Count"
                        @bind-Text="@both"
                        Rows="@(AppData.WindowHeight / 75)" />
        <ListDiffResult Title="A Or B (All)"
                        Count="@allList.Count"
                        @bind-Text="@all"
                        Rows="@(AppData.WindowHeight / 75)" />
    </RadzenStack>
</RadzenStack>

@code {
    string? stringA,
            stringB,
            splitString,
            aOnly,
            bOnly,
            both,
            all;
    List<string> aOnlyList = [],
                 bOnlyList = [],
                 bothList = [],
                 allList = [];
    Orientation Orientation { get; set; } = Orientation.Horizontal;
    FlexWrap Wrap { get; set; } = FlexWrap.NoWrap;
    IEnumerable<int> options = [2, 3];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            if (AppData.WindowHeight > AppData.WindowWidth)
            {
                Orientation = Orientation.Vertical;
                Wrap = FlexWrap.Wrap;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await DialogService.OpenAsync<CustomDialog>(
                "OnAfterRenderAsync Error",
                new Dictionary<string, object?>
                {
                    { "Type", Enums.DialogTypes.Error },
                    { "Message", $"{ex}" }
                }, Constants.DialogOptions);
        }
    }

    void RenderList()
    {
        try
        {
            var caseOption = options.Any(x => x == 1)
                ? StringComparer.Ordinal
                : StringComparer.OrdinalIgnoreCase;
            var splitOptions = options.Any(x => x == 2)
                ? StringSplitOptions.TrimEntries
                : StringSplitOptions.None;
            var sort = options.Any(x => x == 3);
            var ignoreList = splitString?.ToCharArray().Append('\n').ToArray() ?? ['\n'];
            var listA = stringA?.Split(ignoreList, splitOptions | StringSplitOptions.RemoveEmptyEntries) ?? [];
            var listB = stringB?.Split(ignoreList, splitOptions | StringSplitOptions.RemoveEmptyEntries) ?? [];
            var setA = new HashSet<string>(listA, caseOption);
            var setB = new HashSet<string>(listB, caseOption);
            allList = listA.Union(listB, caseOption)?.ToList() ?? [];

            aOnlyList = [.. setA.Except(setB, caseOption)];
            bOnlyList = [.. setB.Except(setA, caseOption)];
            bothList = [.. setA.Intersect(setB, caseOption)];

            if (sort)
            {
                aOnlyList.Sort(caseOption);
                bOnlyList.Sort(caseOption);
                bothList.Sort(caseOption);
                allList.Sort(caseOption);
            }
            aOnly = string.Join(System.Environment.NewLine, aOnlyList);
            bOnly = string.Join(System.Environment.NewLine, bOnlyList);
            both = string.Join(System.Environment.NewLine, bothList);
            all = string.Join(System.Environment.NewLine, allList);
        }
        catch (Exception ex)
        {
            ex.Display(DialogService);
        }
    }

}
